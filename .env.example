# ==============================================================================
# 🔐 듀얼코어 콕핏 (DualCore Cockpit) 환경변수 설정 템플릿 (.env.example)
# ==============================================================================
# [주의사항]
# 1. 실제 비밀번호, API 키 등 민감한 정보는 이 파일에 적지 마시고, 
#    이 파일을 복사하여 '.env' 파일에 기입하십시오.
# 2. '.env' 파일은 .gitignore에 의해 Git 원격 저장소에 절대 업로드되지 않습니다.
# 3. Vite 환경에서 브라우저 클라이언트가 접근할 수 있는 변수는 'VITE_'로 시작해야 합니다.
# 4. 'VITE_'가 붙지 않은 변수는 서버 사이드 및 백엔드 전용 비밀 키로 브라우저에 노출되지 않습니다.
# ==============================================================================

# ------------------------------------------------------------------------------
# 🌐 1. 프론트엔드 클라이언트 설정 (Vite Client Variables)
# ------------------------------------------------------------------------------
# 동기화 서버 및 API 기본 엔드포인트 (로컬 개발: http://localhost:8000)
VITE_API_BASE_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 🔥 Firebase Web SDK 설정 (전국 실시간 D-Day 전광판 및 Firestore 동기화)
# Firebase 콘솔 (https://console.firebase.google.com/) -> 프로젝트 설정 -> 웹 앱 구성값
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# Firebase 실시간 데이터베이스 연동 URL (선택 사항)
VITE_FIREBASE_DB_URL=

# 실행 환경 (development / production)
VITE_APP_ENV=development


# ------------------------------------------------------------------------------
# 🖥️ 2. 파이썬 백엔드 동기화 서버 설정 (Python Server Variables)
# ------------------------------------------------------------------------------
# 서버 구동 포트
PORT=8000

# PIN 동기화 데이터베이스 저장 파일명
SYNC_DATA_FILE=rooms_data.json

# CORS 허용 출처 (* 또는 https://your-production-domain.com)
ALLOWED_ORIGIN=*


# ------------------------------------------------------------------------------
# 🔒 3. 데이터베이스 접속 및 서버 비밀 키 (Database & Server Secrets)
# [중요] 절대 클라이언트 코드나 Git에 커밋하지 마십시오.
# ------------------------------------------------------------------------------
# 데이터베이스 호스트 주소 (예: localhost 또는 AWS RDS / Supabase 호스트)
DB_HOST=localhost

# 데이터베이스 포트 (PostgreSQL: 5432, MySQL: 3306)
DB_PORT=5432

# 데이터베이스 이름
DB_NAME=cit_cockpit_db

# 데이터베이스 계정명
DB_USER=your_db_user

# 데이터베이스 비밀번호 (강력한 난수 사용 권장)
DB_PASSWORD=your_db_secure_password_here

# 백엔드 관리자 및 API 시크릿 키
API_SECRET_KEY=your_secret_api_key_here
